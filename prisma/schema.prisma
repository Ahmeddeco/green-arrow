generator zod {
  provider                         = "zod-prisma-types"
  output                           = "../src/generated/zod"
  useMultipleFiles                 = true
  writeNullishInModelTypes         = true
  createModelTypes                 = true
  writeBarrelFiles                 = false
  createInputTypes                 = false
  addInputTypeValidation           = false
  addIncludeType                   = false
  addSelectType                    = false
  validateWhereUniqueInput         = false
  createOptionalDefaultValuesTypes = false
  createRelationValuesTypes        = false
  createPartialTypes               = false
  useDefaultValidators             = false
  coerceDate                       = false
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// جلسات تسجيل الدخول الخاصة بالمستخدمين (تدار غالباً عبر مكتبة الـ Auth)
model Session {
  id             String   @id @default(cuid())
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String? // في حال قيام مسؤول الدعم بتقمص حساب المستخدم لحل مشكلة

  @@index([userId])
  @@map("session")
}

// حسابات الربط الخارجي للمستخدمين (مثل تسجيل الدخول بجوجل أو كلمة المرور)
model Account {
  id                    String    @id @default(cuid())
  accountId             String // المعرف القادم من المزود الخارجي (مثل Google ID)
  providerId            String // اسم المزود (مثل "google" أو "credentials")
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String? // التشفير الخاص بكلمة المرور في حال التسجيل التقليدي
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

// رموز التحقق لتأكيد البريد الإلكتروني أو استعادة كلمة المرور
model Verification {
  id         String   @id @default(cuid())
  identifier String // الهدف من التحقق (مثل البريد الإلكتروني للمستخدم)
  value      String // الرمز العشوائي المرسل (Token)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// الجدول الرئيسي للمستخدمين والصلاحيات وبيانات الشحن والتواصل
model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false)
  image              String? // رابط الصورة الشخصية للمستخدم
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  role               Role?     @default(user)
  banned             Boolean?  @default(false)
  banReason          String?
  banExpires         DateTime?
  sessions           Session[]
  accounts           Account[]
  mainMobile         String?   @unique // رقم الهاتف الأساسي وعادة يستعمل للتواصل أو الدفع
  secondaryMobile    String?   @unique // رقم هاتف احتياطي لضمان الوصول للعميل عند الشحن
  city               String? // المدينة (لتحديد مناديب الشحن المناسبين)
  state              String? // المحافظة أو الولاية
  country            String?
  lng                Float? // الإحداثيات الجغرافية (خط الطول) لتحديد دقيق للمزرعة أو المحل
  lat                Float? // الإحداثيات الجغرافية (دائرة العرض)
  addressDescription String? // وصف العنوان تفصيلياً (علامات مميزة) لتسهيل الشحن
  factory            Factory[] // المصانع أو الشركات المملوكة للمستخدم إذا كان Seller/Provider
  orders             Order[]

  @@map("user")
}

// الأدوار والصلاحيات داخل السيستم لحماية الـ Routes والـ Actions
enum Role {
  user // مستخدم عام تصفح فقط
  admin // مدير السيستم بالكامل
  seller // تاجر أو موزع محلي
  client // عميل تجاري (مزارع، صاحب محل أسمدة)
  provider // شركة أو مصنع مبيدات مصنع للمنتجات
}

// الشركات أو المصانع المصنعة أو المستوردة للمبيدات والمنتجات الزراعية
model Factory {
  id        String    @id @default(cuid())
  name      String // اسم الشركة أو المصنع (مثلا: سينجنتا، باير، كفر الزيات)
  products  Product[]
  address   String?
  tel       String    @unique
  email     String?
  website   String?
  logo      String?
  owner     User      @relation(fields: [userId], references: [id])
  userId    String // المستخدم المسؤول عن إدارة بيانات هذا المصنع بالسيستم
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// المواد الفعالة التي تدخل في تركيب المبيدات والمركبات الزراعية
model Component {
  id        String             @id @default(cuid())
  title     String             @unique // اسم المادة الفعالة (مثل: Abamectin, Imidacloprid)
  unit      ComponentUnit      @default(percentage)
  products  ProductComponent[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([title])
}

// المنتجات والمبيدات المعروضة للبيع في المتجر
model Product {
  id                 String             @id @default(cuid())
  title              String // الاسم التجاري للمنتج (مثل: تاك، شالنجر)
  activeComponents   ProductComponent[]
  description        String? // شرح للمنتج، الآفات المستهدفة، ومعدلات الاستخدام
  productUrl         String? // رابط خارجي للمنتج أو لصحيفة البيانات الفنية (Data Sheet)
  stock              Float              @default(0) // كمية المخزون (Float لدعم بيع اللترات أو الكيلوات السائبة)
  size               Float
  unit               ProductUnit        @default(cm)
  price              Float              @default(0) // السعر الحالي للمنتج بالمتجر
  discountPercentage Float?             @default(0) // نسبة الخصم إن وجدت (مثال: 15% تخفض من السعر تلقائياً)
  mainImage          String // الصورة الرئيسية للمنتج في الكارت والمعاينات
  images             String[] // ألبوم الصور الإضافية (تفاصيل العبوة، ظهر العبوة للتعليمات)
  category           Category // القسم التجاري والفني للمنتج
  recommendations    String?
  features           String?
  phi                String
  factory            Factory            @relation(fields: [factoryId], references: [id])
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  factoryId          String
  orderItems         OrderItem[]

  @@index([factoryId])
}

enum ProductUnit {
  liter
  cm
  gm
  kg
  piece
  seed
}

// الجدول الوسيط لربط المواد الفعالة بالمنتجات مع تحديد تركيز كل مادة
model ProductComponent {
  productId     String
  componentId   String
  concentration Float?
  unit          ComponentUnit @default(percentage)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  component     Component     @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@id([productId, componentId])
  @@index([componentId])
}

enum ComponentUnit {
  g_liter    @map("جم/لتر")
  percentage @map("%")
  g_kg       @map("جرام/كيلوجرام")
  ppm        @map("جزء في المليون")
  ppb        @map("جزء في المليار")
}

// تصنيفات المنتجات الزراعية والمبيدات حسب نوع الآفة أو الطبيعة التجارية
enum Category {
  herbicides // مبيدات حشائش
  insecticides // مبيدات حشرية
  fungicides // مبيدات فطرية
  acaricides // مبيدات أكاروسية (العنكبوت الأحمر والقراديات)
  nematicides // مبيدات نيماتودا
  growth_regulators // منظمات نمو زراعية ومحفزات
  fertilizers // أسمدة ومغذيات (عناصر كبرى وصغرى، أحماض أمينية)
  seeds // تقاوي وبذور محاصيل وخضروات
  tools // معدات وآلات زراعية (رشاشات، مقصات، إلخ)
}

// طلبات الشراء والعمليات المالية داخل المتجر
model Order {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  totalAmount Float // القيمة الإجمالية للطلب بعد حساب الخصومات والشحن
  status      OrderStatus @default(pending)
  address     String // العنوان الدقيق الفعلي الذي اختاره العميل لشحن هذا الطلب تحديداً
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([userId])
}

// العناصر المشتراة داخل كل طلب بشكل مفصل
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int // الكمية المطلوبة من المنتج
  price     Float // تثبيت سعر المنتج وقت الشراء لحماية الفاتورة من تغير الأسعار اللاحق بالمتجر

  @@index([orderId])
  @@index([productId])
}

// المراحل الزمنية وحالة الطلب بدءاً من إنشائه وحتى وصوله للمشتري
enum OrderStatus {
  pending // بانتظار المراجعة أو تأكيد الدفع
  processing // جاري تجهيز وتعبئة المنتجات في المخزن
  shipped // تم تسليم الشحنة لشركة الشحن أو المندوب وهي في الطريق
  delivered // تم تسليم الشحنة للعميل بنجاح واستلام المبلغ
  cancelled // طلب ملغي (من العميل أو لعدم توفر مخزون)
}
